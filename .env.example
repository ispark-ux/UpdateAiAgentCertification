# ---- AI Agent Certification Platform ----

# Gemini (server-side only - never exposed to the browser)
GEMINI_API_KEY=your_gemini_api_key_here
LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
EVALUATION_MODEL=gemini-2.5-flash
# Model that WATCHES the screen recording (defaults to EVALUATION_MODEL). gemini-2.5-pro reads small on-screen text better.
# SCREEN_ANALYSIS_MODEL=gemini-2.5-pro
# Optional frame resolution for the screen video: MEDIA_RESOLUTION_LOW | MEDIA_RESOLUTION_MEDIUM | MEDIA_RESOLUTION_HIGH
# SCREEN_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH
LIVE_API_VERSION=v1alpha

# Supabase (optional). Run supabase/schema.sql in the SQL editor first.
# When both are set, all data + recordings are stored in Supabase; otherwise local JSON files are used.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key
SUPABASE_RECORDINGS_BUCKET=recordings

# Public URL used in emailed links (defaults to the request origin)
# PUBLIC_BASE_URL=https://certification.yourcompany.com

# Size of each recording part stored in Supabase Storage (default 5 MB)
# RECORDING_PART_BYTES=5242880
